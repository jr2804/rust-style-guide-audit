# Python
__pycache__/
*.py[oc]
.venv/
*.egg-info/

# Tool caches and scratch output — the pytest cache lives under tmp/ by design
tmp/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.ty_cache/

# Skills installed by `mise run add-skills` (vendored from upstream repos)
.agents/skills/
skills-lock.json

# Keep .agents/ DOX files tracked (override any blanket ignore)
/.agents/*
!/.agents/*.md
!/.agents/history/
!/.agents/history/**
!/.agents/files/
!/.agents/files/**
!/.agents/policies/
!/.agents/policies/**
!/.agents/tools/
!/.agents/tools/**
!/.agents/maintenance/
!/.agents/maintenance/**

# Implementation plans — mutable working artifacts, never committed
/.agents/plans/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local mise overrides and secrets
mise.local.toml
*.env
.env

# Build artifacts
build/
dist/
/.rumdl_cache
